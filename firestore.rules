rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Daftar email admin (boleh lebih dari satu, pisahkan dengan koma).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@gmail.com'];
    }

    /* ---------------------------------------------------------
       SESI MEJA
       tables/{id} menyimpan sesi yang sedang berjalan:
         sessionId       : kode acak sesi ('' = meja kosong)
         sessionOpenedAt : waktu sesi dibuka (diisi pelanggan saat scan QR)
         sessionUntil    : batas waktu yang diperpanjang admin saat pesanan diproses
       Sesi dianggap hidup bila:
         sekarang < sessionOpenedAt + 15 menit   (jendela tamu, untuk memesan pertama kali)
         ATAU sekarang < sessionUntil            (diperpanjang admin)
       --------------------------------------------------------- */
    function tableData(id) {
      return get(/databases/$(database)/documents/tables/$(id)).data;
    }

    function sessionLive(t) {
      return t.get('sessionId', '') is string
        && t.get('sessionId', '') != ''
        && ( (t.get('sessionOpenedAt', null) is timestamp
              && request.time < t.sessionOpenedAt + duration.value(15, 'm'))
          || (t.get('sessionUntil', null) is timestamp
              && request.time < t.sessionUntil) );
    }

    /* ---------------------------------------------------------
       JAM BUKA + SAKLAR TERIMA PESANAN  (settings/outlet)
         acceptOrders : true/false (saklar manual)
         tzOffset     : selisih zona waktu dalam menit (WIB = 420)
         schedule     : daftar 7 hari, indeks 0 = Minggu ... 6 = Sabtu
                        tiap hari { open: bool, from: menit, to: menit }  (menit sejak 00.00)
       Bila schedule belum diatur, dianggap selalu buka.
       --------------------------------------------------------- */
    function outletCfg() {
      return get(/databases/$(database)/documents/settings/outlet).data;
    }

    function openNow(c) {
      let ms = request.time.toMillis() + c.get('tzOffset', 420) * 60000;
      let days = int(ms / 86400000);                     // int() memotong ke bilangan bulat (ms selalu positif)
      let wd = (days + 4) % 7;                           // 1 Jan 1970 = Kamis (4)
      let mins = (ms % 86400000) / 60000;
      return c.get('acceptOrders', true) == true
        && ( c.get('schedule', null) == null
          || ( c.schedule[wd].open == true
            && mins >= c.schedule[wd].from
            && mins < c.schedule[wd].to ) );
    }

    // Data yang dibaca pelanggan: publik baca, hanya admin yang boleh ubah
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /menu/{id}       { allow read: if true; allow write: if isAdmin(); }

    // Meja: pelanggan hanya boleh MEMBUKA sesi pada meja yang kosong / sesinya sudah habis,
    // dan hanya bila kedai sedang menerima pesanan. Admin bebas mengubah.
    match /tables/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['sessionId', 'sessionOpenedAt'])
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() >= 12
                    && request.resource.data.sessionId.size() <= 40
                    && request.resource.data.sessionOpenedAt == request.time
                    && !sessionLive(resource.data)
                    && openNow(outletCfg());
    }

    /* ---------------------------------------------------------
       PEMBAYARAN (settings/outlet)
         payMode     : 'awal' = bayar dulu baru masuk dapur | 'akhir' = langsung ke dapur
         payTransfer : true/false     payCash : true/false
       Mode 'awal': pesanan dibuat berstatus 'menunggu_bayar' dengan payMethod 'transfer' atau 'cash'.
         transfer -> pelanggan mengunggah bukti (maks 3 kali, dalam 15 menit sejak dibuat) -> admin memverifikasi
         cash     -> kasir menekan "Terima tunai"
       Mode 'akhir' (default): status awal 'baru' seperti sebelumnya.
       --------------------------------------------------------- */
    function payOk(d) {
      let c = outletCfg();
      return c.get('payMode', 'akhir') == 'awal'
        ? ( d.status == 'menunggu_bayar'
            && d.get('payMethod', '') in ['transfer', 'cash']
            && ( (d.payMethod == 'transfer' && c.get('payTransfer', true) == true)
              || (d.payMethod == 'cash' && c.get('payCash', true) == true) )
            && d.get('proofs', []).size() == 0 )
        : d.status == 'baru';
    }

    // Pelanggan mengirim bukti transfer: hanya menambah 1 entri 'proofs', status -> 'verifikasi'
    function proofUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      return o.get('payMethod', '') == 'transfer'
        && o.status == 'menunggu_bayar'
        && n.diff(o).affectedKeys().hasOnly(['proofs', 'status'])
        && n.status == 'verifikasi'
        && n.proofs is list
        && n.proofs.size() == o.get('proofs', []).size() + 1
        && n.proofs.size() <= 3
        && n.proofs[n.proofs.size() - 1].url.matches('^https://res\\.cloudinary\\.com/yjthurvv/.*')
        && request.time < o.createdAt + duration.value(15, 'm');
    }

    // Pesanan
    //  - create : pelanggan, hanya saat kedai buka dan sesi mejanya hidup (sessionId cocok)
    //  - get    : siapa pun yang tahu ID pesanan (ID acak 20 karakter) -> memantau status pesanannya
    //  - list   : hanya admin
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['code','mejaId','mejaName','area','items','count','total','note','status','createdAt','sessionId','fee','payMethod','proofs'])
                    && payOk(request.resource.data)
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.fee is map
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.mejaId is string
                    && request.resource.data.sessionId is string
                    && tableData(request.resource.data.mejaId).get('sessionId', '') == request.resource.data.sessionId
                    && sessionLive(tableData(request.resource.data.mejaId))
                    && openNow(outletCfg());
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin() || proofUpdate();
      allow delete: if isAdmin();
    }

    // Chat pelanggan <-> admin
    //  chatId = kode acak di perangkat pelanggan. Hanya yang tahu kodenya yang bisa membaca percakapan,
    //  dan hanya admin yang bisa melihat daftar semua percakapan.
    //  Pelanggan hanya boleh menulis saat sesi mejanya hidup.
    function chatOk(d) {
      return d.keys().hasOnly(['mejaId','mejaName','area','lastMessage','lastAt','lastFrom','unreadAdmin','sessionId'])
          && d.lastMessage is string && d.lastMessage.size() <= 120
          && d.unreadAdmin is int && d.unreadAdmin >= 0 && d.unreadAdmin < 1000
          && d.lastFrom == 'user'
          && d.lastAt == request.time
          && d.mejaId is string
          && d.sessionId is string
          && tableData(d.mejaId).get('sessionId', '') == d.sessionId
          && sessionLive(tableData(d.mejaId));
    }

    match /chats/{chatId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if chatOk(request.resource.data);
      allow update: if isAdmin() || chatOk(request.resource.data);
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow get, list: if true;
        allow create: if request.resource.data.keys().hasOnly(['from','text','createdAt','image'])
                      && (!('image' in request.resource.data)
                          || request.resource.data.image.matches('^https://res\\.cloudinary\\.com/yjthurvv/.*'))
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt == request.time
                      && ( (request.resource.data.from == 'admin' && isAdmin())
                        || (request.resource.data.from == 'user'
                            && sessionLive(tableData(
                                 getAfter(/databases/$(database)/documents/chats/$(chatId)).data.mejaId))) );
        allow update, delete: if isAdmin();
      }
    }
  }
}
